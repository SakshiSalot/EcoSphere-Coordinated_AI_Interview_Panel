# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. This template is committed, so it must never contain a
# real value — a public repository at submission would leak the account.

# --- Agora --------------------------------------------------------------
# TWO different credential pairs that do different jobs. Mixing them up is the
# single most common hour lost on this project.
#   App ID + App Certificate  -> sign RTC tokens (joining a voice channel)
#   Customer ID + Secret      -> authenticate REST calls (starting an agent)
# Console -> your project. Customer ID/Secret are under the RESTful API section.
# Conversational AI Engine must be ENABLED on the project or every join fails.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Language models ----------------------------------------------------
# Groq writes what the interviewers say (fast, free): console.groq.com
# Gemini plans questions and scores answers (separate quota, so heavy analysis
# can never starve the conversation): aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional fallbacks for when Groq hits its rate limit mid-interview.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- GitHub verification (optional) -------------------------------------
# Works without this: GitHub's public API allows 60 requests an hour without a
# token, which is about three profile checks. A token raises that to 5000.
# It needs NO SCOPES AT ALL — this only ever reads public data, and a scoped
# token would hand a hackathon server write access to your repositories.
# github.com/settings/tokens -> fine-grained -> no permissions.
GITHUB_TOKEN=

# --- Gateway ------------------------------------------------------------
# A password you invent. It goes into Agora's agent config and is checked on
# every request — without it your public endpoint is open to anyone.
GATEWAY_SHARED_SECRET=

# The public HTTPS address of YOUR gateway, no trailing slash.
# Each person needs their own: `make tunnel` prints one.
GATEWAY_PUBLIC_URL=

# --- Panel --------------------------------------------------------------
# Agora bills per AGENT-minute. Three interviewers in a ten-minute interview
# costs thirty minutes, not ten. Develop at 2, demo at 3.
PANEL_SIZE=2

# Optional: choose the panel by name instead of by size.
#   technical, product, behavioural, hiring_manager, customer
# PANEL_ROLES=technical,hiring_manager,customer

# Seconds of silence before Agora drops an agent. Low so a crashed test stops
# billing quickly; the scripts raise it for manual runs.
AGORA_IDLE_TIMEOUT=180

# How a non-speaking persona is silenced. Leave as-is unless agents talk over
# each other, then try done_only.
SILENCE_MODE=empty_completion

# --- Shared database (optional) -----------------------------------------
# Turso is SQLite with a network in front of it, so the schema and every query
# are identical either way — only the connection differs. Leave both empty and
# the app uses a local file at data/echosphere.db, which is the right choice
# for working alone.
#
# Set them and the whole team, and the deployment, see the same accounts,
# openings and assessments. A teammate who leaves TURSO_URL blank silently gets
# their own empty database and wonders where everyone's data went.
TURSO_URL=
TURSO_AUTH_TOKEN=
