# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Agora (App Certificate signs RTC tokens; Customer ID/Secret authenticate REST) ---
AGORA_APP_ID=8746b777f1c9475885b509cf4937be4e
AGORA_APP_CERTIFICATE=d16b0a43f51949a4bb892d20cd7871cb
AGORA_CUSTOMER_ID=f51c65e158664496bfcb48bcb0a63e6c
AGORA_CUSTOMER_SECRET=74f8d4571ccb4343b53d30496e08cebb

# --- LLM providers ---
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Gateway ---
# A value you invent. Goes into Agora's agent config as llm.api_key and is
# verified on every request — without it your public endpoint is open to anyone.
GATEWAY_SHARED_SECRET=change-me-to-something-random

# Public HTTPS base URL of the gateway, no trailing slash.
# Dev: your cloudflared tunnel URL. Prod: your Hugging Face Space URL.
GATEWAY_PUBLIC_URL=

# --- Panel ---
# Agora bills per AGENT-minute. 3 personas x 10 min = 30 minutes, not 10.
# Develop and test at 2. Switch to 3 only for integration runs and the video.
PANEL_SIZE=2

# Agent auto-disconnects after this many seconds of silence. Keep it low so a
# crashed test does not bill until someone notices.
AGORA_IDLE_TIMEOUT=30

# How the gateway silences a non-speaking persona. Day 1 unknown — test both.
#   empty_completion = well-formed chunk with empty content, then [DONE]
#   done_only        = emit only [DONE]
SILENCE_MODE=empty_completion
