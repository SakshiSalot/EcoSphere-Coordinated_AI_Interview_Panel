# secrets — this line exists before .env was ever created
.env
.env.*
# the blank template IS committed — a collaborator cloning needs it
!.env.example

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# runtime artefacts
out/
sessions/
*.log

# Working notes, generated PDFs and — importantly — a file of Agora REST keys
# live here. Ignored wholesale, then the deployment guide is let back in: it is
# the one thing in docs/ that somebody cloning this repo actually needs, and
# ignoring the directory meant it shipped to nobody.
#
# The pattern has to be /docs/* rather than /docs. Git does not descend into an
# excluded DIRECTORY, so a negation inside one never matches.
/docs/*
!/docs/DEPLOY.md

# os
.DS_Store


# candidate CVs are personal data and this repo goes public at submission
inputs/resume/*
!inputs/resume/.gitkeep

# the accounts database - real people, hashed passwords, never committed
data/
*.db
*.db-wal
*.db-shm

# the browser app
frontend/node_modules/
frontend/dist/
