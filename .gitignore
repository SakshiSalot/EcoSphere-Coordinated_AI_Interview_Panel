# secrets — this line exists before .env was ever created
.env
.env.*
# the blank template IS committed — a collaborator cloning needs it
!.env.example

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# runtime artefacts
out/
sessions/
*.log

/docs

# os
.DS_Store


# candidate CVs are personal data and this repo goes public at submission
inputs/resume/*
!inputs/resume/.gitkeep

# the accounts database - real people, hashed passwords, never committed
data/
*.db
*.db-wal
*.db-shm

# the browser app
frontend/node_modules/
frontend/dist/
